graph TB
    subgraph BTC["Bitcoin"]
        direction TB

        DepBTC["Depositor BTC"]
        DepositTx{{"Peg-in deposit"}}
        PegIn["Peg-in output at Q<br/>Y<sub>51</sub> | Y<sub>fed</sub> + CSV | refund + CSV"]
        Beacon["OP_RETURN<br/>BFR || Q_auth"]

        Head["Treasury head<br/>Y<sub>51</sub> | Y<sub>fed</sub> + CSV"]
        TMTx{{"Treasury Movement<br/>FROST, 51% roster"}}
        NewHead["New treasury output"]
        Payouts["Peg-out payouts"]
        BTMR1["OP_RETURN BTMR1<br/>spi_root || cpo_root"]

        DepBTC --> DepositTx
        DepositTx --> PegIn
        DepositTx --> Beacon
        PegIn -. "refund after timeout" .-> DepBTC
        Head --> TMTx
        PegIn -- "swept" --> TMTx
        TMTx --> NewHead
        TMTx --> Payouts
        TMTx --> BTMR1
    end

    subgraph ADA["Cardano"]
        direction TB

        Config["Config (BIFCFG)"]
        TState["Treasury state (BFRTRY)<br/>Y<sub>51</sub>, identity root"]
        Registry["SPO registry"]
        Oracle["Binocular oracle"]
        BSS["Bridge state (BSS)<br/>spi_root, cpo_root, head"]
        CPI["Completed peg-ins trie (CPI)"]
        PIR["PegInRequest"]
        POR["PegOut request<br/>locked fBTC"]
        UTM["Unconfirmed TM<br/>signed tx bytes"]

        RegTx{{"Register / Deregister"}}
        UpdY{{"Update-Y"}}
        CreatePIR{{"Create PegInRequest"}}
        CreatePOR{{"Create PegOut"}}
        Build(["SPO program:<br/>build and sign the TM"])
        PostTM{{"Post TM"}}
        ConfirmTM{{"Confirm TM"}}
        CompletePI{{"Complete peg-in<br/>mint fBTC"}}
        CompletePO{{"Complete peg-out<br/>burn fBTC"}}
        Timeout{{"Close / Cancel<br/>after timeout"}}
        fBTC["fBTC"]

        %% registry and key rotation
        Registry --> RegTx
        RegTx --> Registry
        TState --> RegTx
        RegTx --> TState
        Config -.-> RegTx
        TState --> UpdY
        UpdY -- "new Y<sub>51</sub>" --> TState

        %% requests
        Oracle -. "inclusion proof" .-> CreatePIR
        CreatePIR --> PIR
        CreatePOR --> POR

        %% the SPO program builds the TM from Cardano data
        PIR -.-> Build
        POR -.-> Build
        BSS -. "head" .-> Build
        Config -. "params" .-> Build
        TState -. "Y<sub>51</sub>" .-> Build
        Registry -. "roster" .-> Build
        Build --> PostTM
        PostTM --> UTM
        Config -.-> PostTM
        BSS -. "head" .-> PostTM

        %% confirm: roots copied from the posted bytes
        UTM --> ConfirmTM
        BSS --> ConfirmTM
        ConfirmTM -- "roots, head" --> BSS
        Oracle -. "confirmed" .-> ConfirmTM
        Config -.-> ConfirmTM

        %% completions
        PIR --> CompletePI
        CPI --> CompletePI
        CompletePI --> CPI
        BSS -. "spi_root" .-> CompletePI
        Config -.-> CompletePI
        CompletePI --> fBTC
        POR --> CompletePO
        BSS -. "cpo_root" .-> CompletePO
        Config -.-> CompletePO

        %% exits
        PIR --> Timeout
        POR --> Timeout
        BSS -. "non-membership" .-> Timeout
        CPI -. "duplicate" .-> Timeout
        Config -.-> Timeout
    end

    %% cross-chain
    TState -. "Y<sub>51</sub>" .-> DepositTx
    Config -. "Y<sub>fed</sub>, CSV" .-> DepositTx
    Beacon == "watchtower" ==> CreatePIR
    UTM == "watchtower" ==> TMTx
    BTMR1 == "same bytes" ==> ConfirmTM

    %% Styling
    classDef btcNode fill:#f9a825,stroke:#f57f17,color:#000
    classDef btcTx fill:#fff9c4,stroke:#f57f17,color:#000
    classDef adaNode fill:#42a5f5,stroke:#1565c0,color:#fff
    classDef adaTx fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef offchain fill:#ffffff,stroke:#1565c0,stroke-dasharray:4 3,color:#000
    classDef btcBox fill:#fff8e1,stroke:#f57f17,color:#000
    classDef adaBox fill:#e3f2fd,stroke:#1565c0,color:#000

    class DepBTC,PegIn,Beacon,Head,NewHead,Payouts,BTMR1 btcNode
    class DepositTx,TMTx btcTx
    class Config,TState,Registry,Oracle,BSS,CPI,PIR,POR,UTM,fBTC adaNode
    class RegTx,UpdY,CreatePIR,CreatePOR,PostTM,ConfirmTM,CompletePI,CompletePO,Timeout adaTx
    class Build offchain
    class BTC btcBox
    class ADA adaBox
